{
  "uid": "platform-health",
  "title": "Platform health",
  "description": "Are the services, the broker and their dependencies up, and is the telemetry pipeline itself healthy? (docs/features/observability, OB-8)",
  "tags": [
    "platform-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Readiness and liveness (probed by the collector every 10 s)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Readiness",
      "description": "1 = the /health/ready probe answers 2xx. Keycloak's own readiness is included; RabbitMQ is up when Prometheus can scrape it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (label_replace(httpcheck_status{http_status_class=\"2xx\", http_url=~\".*/health/ready\"}, \"service\", \"$1\", \"http_url\", \"http://([^:]+):.*\"))",
          "legendFormat": "{{service}}",
          "interval": "",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{job=\"rabbitmq\"})",
          "legendFormat": "rabbitmq",
          "interval": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ready",
                  "color": "green"
                },
                "0": {
                  "text": "NOT READY",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Liveness",
      "description": "A database or broker outage must never make a service look dead: liveness stays up while readiness goes down.",
