    {
      "type": "timeseries",
      "title": "Orders created vs notifications processed",
      "description": "The two lines should follow each other; a gap that keeps growing means the pipeline is losing or delaying events.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(orders_created_total[$__rate_interval]))",
          "legendFormat": "orders created",
          "interval": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(notification_messages_total{outcome=\"processed\"}[$__rate_interval]))",
          "legendFormat": "notifications processed",
          "interval": ""
