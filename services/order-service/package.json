    "@opentelemetry/sdk-node": "^0.300.0",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "nestjs-pino": "^5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1"
